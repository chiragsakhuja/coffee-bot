# Slack app tokens (create the app from deploy/slack-app-manifest.yml, see docs/SETUP.md)
# Bot User OAuth Token: OAuth & Permissions page, after installing the app to your workspace
SLACK_BOT_TOKEN=xoxb-replace-me
# App-level token with the connections:write scope: Basic Information → App-Level Tokens
SLACK_APP_TOKEN=xapp-replace-me

# Comma-separated Slack member IDs allowed to talk to the bot
# (your profile → ⋮ → Copy member ID), e.g. U012AB3CDE
ALLOWED_USER_IDS=U012AB3CDE

# OpenRouter API key (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Where rendered images are written (point your HTTP server here)
OUTPUT_DIR=./output

# Where menu.json and history snapshots live
DATA_DIR=./data

# OpenRouter model slug (https://openrouter.ai/models). Must support tool calling and image input.
MODEL=anthropic/claude-opus-5-5

# Timezone used for "days since roast" and the nightly re-render (IANA name)
TIMEZONE=America/Los_Angeles

# ---- TRMNL device server (built in) ----
# Address/port the HTTP server listens on. Point the TRMNL's "API server" at http://<server-ip>:<port>
HTTP_HOST=0.0.0.0
HTTP_PORT=9157

# Optional: absolute base URL used in image links sent to the device. Leave empty to derive it
# from the Host header the device uses (works on a LAN without configuration).
PUBLIC_BASE_URL=

# Which image the device gets: auto (2-bit PNG for firmware >= 1.6, else 1-bit PNG), 2bit, 1bit, bmp
IMAGE_FORMAT=auto

# Send a Slack DM when the device battery drops below this voltage
LOW_BATTERY_VOLTS=3.5
